---
// Navbar.astro
// Menú móvil implementado con <details>/<summary> en vez de JS + estado:
// funciona sin hidratar nada, es accesible por teclado de forma nativa
// y no añade JavaScript al bundle solo para abrir/cerrar un menú.

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border">
  <nav class="container-page flex items-center justify-between py-5" aria-label="Principal">
    <a href="/" class="font-heading text-lg font-semibold no-underline text-text-primary hover:text-accent">
      front<span class="text-accent">/</span>diary
    </a>

    <!-- Navegación de escritorio -->
    <ul class="hidden md:flex items-center gap-8 text-sm">
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'no-underline transition-colors',
                  isActive ? 'text-text-primary font-medium' : 'text-text-secondary hover:text-text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Menú móvil -->
    <details class="md:hidden relative">
      <summary
        class="list-none cursor-pointer select-none rounded-md border border-border px-3 py-1.5 text-sm text-text-secondary"
        aria-label="Abrir menú de navegación"
      >
        Menú
      </summary>
      <ul
        class="absolute right-0 top-full mt-2 flex w-44 flex-col gap-1 rounded-md border border-border bg-surface p-2 text-sm shadow-md"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded px-3 py-2 no-underline text-text-secondary hover:bg-background hover:text-text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
