---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Artículos sobre Frontend, SEO técnico y las tecnologías que voy aprendiendo, escritos por Siyu."
>
  <h1 class="text-3xl font-bold">Blog</h1>
  <p class="mt-2 text-text-secondary">Notas y aprendizajes sobre lo que voy construyendo.</p>

  {
    posts.length > 0 ? (
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    ) : (
      <p class="mt-8 text-sm text-text-secondary">Aún no hay artículos publicados.</p>
    )
  }
</BaseLayout>
