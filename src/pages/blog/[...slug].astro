---
// [...slug].astro
// Genera una página estática por cada entrada de la colección `blog`
// (getStaticPaths) y calcula el artículo anterior/siguiente según la
// fecha de publicación, para la navegación del BlogLayout.

import { getCollection } from 'astro:content';
import BlogLayout from '@layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
  );

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: posts[index - 1],
      nextPost: posts[index + 1],
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
---

<BlogLayout post={post} headings={headings} prevPost={prevPost} nextPost={nextPost}>
  <Content />
</BlogLayout>
